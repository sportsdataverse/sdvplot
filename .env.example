# sdvplot — environment template
# ----------------------------------------------------------------------------
# Copy to `.env` (gitignored), fill in your own values, and load into the shell:
#     bash/zsh:   cp .env.example .env  &&  set -a; source .env; set +a
#     or `uv run --env-file .env ...`
# This template is committed and MUST contain NO real secrets — placeholders only.
# ----------------------------------------------------------------------------

# ===== CONFIGURATION (all optional) =====

# Cache root for the logo manifest, images and rasterized SVGs (default: the platformdirs user cache).
# SDVPLOT_CACHE_DIR=/path/to/cache

# Days before the cached logo manifest is re-checked (default 7).
# SDVPLOT_CACHE_TTL=7

# Set to 1 to run the network tests (live manifest contract, sdvplotR logo parity, notebooks).
# SDVPLOT_LIVE_TESTS=1

# ===== MAINTAINER TOOLS ONLY =====

# CollegeFootballData API key, used only by tools/fetch_sources.py to refresh data-raw/cfbd_teams.csv.
# Get your key from https://collegefootballdata.com/
# CFBD_API_KEY=your_cfbd_key_here
